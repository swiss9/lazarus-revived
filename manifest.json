{
  "manifest_version": 3,
  "name": "Lazarus: Form Recovery",
  "version": "4.3.0",
  "description": "Recover lost form data. Automatically saves everything you type. Now with full‑page restore, version history, and domain blacklist.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lazarus",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "resurrect-last": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Lazarus command palette"
    }
  }
}
