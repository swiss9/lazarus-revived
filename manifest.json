{
  "manifest_version": 3,
  "name": "Lazarus: Form Recovery",
  "version": "4.3.1",
  "description": "Recover lost form data. Automatically saves everything you type.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lazarus",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "open-command-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "Open Lazarus command palette"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
